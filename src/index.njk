        <span class="mono">{{ post.date | readableDate }}</span>
        <div><h3>{{ post.data.title }}</h3>{% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}</div>
        <span class="go-ic"><svg width="14" height="14"><use href="#arr"/></svg></span>
      </a>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:28px"><a href="/blog/" class="btn ghost">All posts <svg><use href="#arr"/></svg></a></div>
  </div>
</section>
{% endif %}
