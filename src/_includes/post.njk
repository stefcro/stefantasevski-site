---
layout: base.njk
ogType: article
backLabel: Home
ctaTitle: Want this applied to your site?
---
{% set readMins = content | readingTime %}
<article class="post-page">
  <header class="post-head">
    <a href="/blog/" class="mono post-crumb">/Blog</a>
    {% if tags %}<div class="chips" style="margin:14px 0 0">{% for t in tags %}{% if t != "posts" %}<span class="chip">{{ t }}</span>{% endif %}{% endfor %}</div>{% endif %}
    <h1>{{ title }}</h1>
    {% if description %}<p class="lead">{{ description }}</p>{% endif %}
    <div class="byline">
      <img src="/assets/stefan.webp" alt="">
      <div><b>Stefan Tasevski</b><span><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ readMins }} min read</span></div>
    </div>
  </header>
  <div class="post-cover">{{ { page: page, data: { tags: tags, title: title, image: image } } | postCover | safe }}</div>
  <div class="prose">
{{ content | safe }}
  </div>
  {% set others = [] %}
  {% for p in collections.posts %}{% if p.url != page.url and others.length < 2 %}{% set others = (others.push(p), others) %}{% endif %}{% endfor %}
  <section class="keep-reading">
    <h2 class="mono">Keep reading</h2>
    <div class="post-list">
      {% for p in others %}
      <a class="post-row has-cover" href="{{ p.url }}">
        <div class="post-thumb">{{ p | postCover | safe }}</div>
        <div><h3>{{ p.data.title }}</h3>{% if p.data.description %}<p>{{ p.data.description }}</p>{% endif %}</div>
        <span class="go-ic"><svg width="14" height="14"><use href="#arr"/></svg></span>
      </a>
      {% endfor %}
    </div>
    <a class="kr-case" href="/case-studies/german-ecommerce/">
      <span class="mono">Case study</span>
      <b>From 15 to 298 top-3 rankings in six months for a German eCommerce brand</b>
      <span class="go-ic"><svg width="14" height="14"><use href="#arr"/></svg></span>
    </a>
  </section>
  <aside class="author-box rv">
    <img src="/assets/stefan.webp" alt="">
    <div>
      <b>Stefan Tasevski</b>
      <p>SEO Lead at Socially Powerful. 10+ years growing organic traffic, leads and revenue for eCommerce, B2B and agency brands in Google and in AI answers.</p>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener" class="mono">Follow on LinkedIn ↗</a>
    </div>
  </aside>
</article>
